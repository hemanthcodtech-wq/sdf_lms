{
  "expo": {
    "name": "Swamy dwija Foundation",
    "slug": "sdf-lms",
    "owner": "student17s-team",
    "scheme": "sdflms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d5c31"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sdflms.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d5c31"
      },
      "package": "com.sdflms.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0d5c31"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you update your profile photo."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://swamidwijafoundation.com/api",
      "eas": {
        "projectId": "ad472c0b-35db-40c3-ae8b-ba5d20cc87ad"
      }
    }
  }
}
